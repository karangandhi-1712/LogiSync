[Unit]
Description=LogiSync v2.0 - VOC Port Command Center FastAPI Server
After=network.target

[Service]
Type=simple
User=logisync
Group=logisync
WorkingDirectory=/opt/logisync/backend
EnvironmentFile=/opt/logisync/.env
ExecStart=/opt/logisync/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4 --proxy-headers --forwarded-allow-ips='*'
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s
PrivateTmp=true
LimitNOFILE=65535

# Logging
StandardOutput=append:/var/log/logisync/api.log
StandardError=append:/var/log/logisync/api-error.log

[Install]
WantedBy=multi-user.target
