# ─────────────────────────────────────────────────────────────────────────────
# LogiSync v2.0 — Environment Variables Template
# Copy to .env and fill in your values. NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── FRONTEND (Vite prefix required) ──────────────────────────────────────────
# Maps: Leaflet + Geoapify raster tiles (free tier). Get a key at geoapify.com.
# NOTE: Google Maps is NOT used by the frontend; VITE_GOOGLE_MAPS_API_KEY is legacy.
VITE_GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY
VITE_GOOGLE_MAPS_API_KEY=

# AWS Cognito (browser-facing client — no secret)
# Leave the placeholder pool id to run in demo mode (no Cognito needed).
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Backend API URL (local dev). For PROD behind Nginx same-origin proxy,
# set VITE_API_URL= (empty) and rebuild, so calls go to /api/... relatively.
VITE_API_URL=http://localhost:8000

# WebSocket URL (local dev). If unset, the app derives it from window.location
# (wss:// on https), so prod needs no rebuild for WS.
VITE_WS_URL=ws://localhost:8000

# ─── BACKEND (FastAPI / Python) ───────────────────────────────────────────────

# --- Google Maps Backend API Key (server-side, unrestricted) ---
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_SERVER_API_KEY
GOOGLE_MAPS_DIRECTIONS_KEY=YOUR_GOOGLE_MAPS_SERVER_API_KEY
GOOGLE_MAPS_GEOCODING_KEY=YOUR_GOOGLE_MAPS_SERVER_API_KEY

# --- AWS Credentials ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# --- Amazon Cognito (backend validation) ---
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_JWKS_URL=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_XXXXXXXXX/.well-known/jwks.json

# --- Amazon SNS (notifications) ---
SNS_TOPIC_ARN_ALERTS=arn:aws:sns:ap-south-1:123456789012:logisync-alerts
SNS_TOPIC_ARN_DISPATCH=arn:aws:sns:ap-south-1:123456789012:logisync-dispatch

# --- Amazon S3 ---
S3_BUCKET_TELEMETRY=logisync-telemetry-ap-south-1
S3_BUCKET_REPORTS=logisync-reports-ap-south-1
S3_BUCKET_GIS=logisync-gis-ap-south-1

# --- Amazon CloudWatch ---
CLOUDWATCH_LOG_GROUP=/logisync/backend
CLOUDWATCH_NAMESPACE=LogiSync/API

# --- Database ---
# SQLite for dev (auto-created file next to backend/). The sync SQLAlchemy engine
# expects the sqlite:// scheme (sqlite+aiosqlite:// is normalized automatically).
DATABASE_URL=sqlite:///./logisync.db
# PostgreSQL for production (requires psycopg, already in requirements.txt).
# With Postgres you may run uvicorn --workers 4; with SQLite keep --workers 1.
# DATABASE_URL=postgresql+psycopg://logisync:YOURPASSWORD@localhost:5432/logisync

# --- Application ---
APP_ENV=development
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_256_BIT_SECRET
CORS_ORIGINS=http://localhost:5173,https://your-production-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1,your-ec2-ip

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# --- Demo Mode (set to true to bypass Cognito JWT validation in dev) ---
DEMO_MODE=true
