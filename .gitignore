yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secret Configurations
.env
.env.*
!.env.example
*.pem
*.key

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
